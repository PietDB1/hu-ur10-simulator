{
  "name": "UR10 robot-simulator (HU)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "shutdownAction": "stopCompose",

  "hostRequirements": { "cpus": 2, "memory": "8gb" },

  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Robot (PolyScope)",
      "onAutoForward": "silent"
    }
  },

  "postAttachCommand": "bash .devcontainer/wacht-op-robot.sh",

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    },
    "codespaces": {
      "openFiles": ["README.md", "voorbeelden/01_eerste_beweging.py"]
    }
  }
}
